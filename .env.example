# Data read order (L26): GitHub raw `fallback` branch of tipping-point-data ->
# Neon bucket -> bundled public/data. Leave DATA_BASE_URL UNSET; when set it
# becomes the ONLY remote source (tests use it to force the bundled copy).
DATA_BASE_URL=
# Optional Neon Object Storage endpoint for the fallback remote (not a secret);
# unset = built-in public bucket URL.
NEON_S3_ENDPOINT=
# Earth Engine at runtime is OFF by default (L25). 1/true enables the GEE API
# routes, the loader overlay and the health probe; needs the two keys below.
GEE_ENABLED=
# Google Cloud project registered for the Earth Engine API (GEE_ENABLED only)
GEE_PROJECT=
# Service-account JSON key for Earth Engine, canonical name (GEE_ENABLED only)
GCP_SA_KEY=
# Legacy fallback name for GCP_SA_KEY
GEE_SERVICE_ACCOUNT_KEY=
# Subscriber DB backend. Unset -> local SQLite; VPS: sqlite:/app/.data/tipping-point.sqlite.
# The VPS notifier shares that persistent volume. Legacy Neon URL is only needed
# during the reviewed migration/rollback; keep secrets out of the repo.
DATABASE_URL=
# Telegram bot token from BotFather
TELEGRAM_TOKEN=
# Shared secret verified on the Telegram webhook
TELEGRAM_SECRET=
# Canonical public app URL (bot links + webhook registration)
APP_URL=
# Earthdata bearer token (GitHub secret of same name; data pipeline, not app runtime)
EARTHDATA_TOKEN=
# Earthdata login fallback pair — local pipeline runs only, prefer EARTHDATA_TOKEN
EDL_USER=
EDL_PASS=
# Command Center: refresh period of the live run in hours (default 3). The
# screen calls live data "stale" after two periods. Public, fixed at build time.
NEXT_PUBLIC_REFRESH_HOURS=
# Command Center: address of the Telegram bot (https://t.me/<bot>). Unset =
# the "Get alerts on Telegram" card is hidden. Public, fixed at build time.
NEXT_PUBLIC_TELEGRAM_BOT_URL=
