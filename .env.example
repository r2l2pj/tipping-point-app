# Base URL of the fallback data copy; defaults to the raw fallback branch of tipping-point-data.
# Unset = default branch URL; bundled public/data is last resort.
DATA_BASE_URL=
# Google Cloud project registered for the Earth Engine API
GEE_PROJECT=
# Service-account JSON key for Earth Engine (canonical name)
GCP_SA_KEY=
# Legacy fallback name for GCP_SA_KEY
GEE_SERVICE_ACCOUNT_KEY=
# Database backend for the subscriber store. Unset or sqlite:<path> -> local SQLite file
# .data/tipping-point.sqlite (gitignored, automatic). postgres://... -> Neon
# (set by infra in production). Not required locally; an explicit SQLite path overrides the default.
# Production connection string is secret and server-only; never commit the real value.
DATABASE_URL=
# Telegram bot token from BotFather
TELEGRAM_TOKEN=
# Shared secret verified on the Telegram webhook
TELEGRAM_SECRET=
# Canonical public app URL (bot links + webhook registration)
APP_URL=
# Earthdata bearer token (GitHub secret of same name; data pipeline, not app runtime)
EARTHDATA_TOKEN=
# Earthdata login fallback pair — local pipeline runs only, prefer EARTHDATA_TOKEN
EDL_USER=
EDL_PASS=
