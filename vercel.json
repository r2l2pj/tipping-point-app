{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "BASE=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git diff --quiet $BASE HEAD -- . ':(exclude)submission' ':(exclude)docs' ':(exclude)*.md' ':(exclude).crew' ':(exclude).herdr'"
}
